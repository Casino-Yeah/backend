{
  "name": "casino-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del Casino Online - Equipo 08",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "seed:generate": "node scripts/generate-seed.js > ${DB_SQL_DIR:-../database}/seed.sql",
    "postman:generate": "node scripts/generate-postman.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
