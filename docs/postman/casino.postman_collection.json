                "auth",
                "registro"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana López\",\n  \"correo\": \"ana@correo.com\",\n  \"password\": \"Secreta123\",\n  \"fechaNacimiento\": \"2000-05-20\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta correcta', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const t = pm.response.json().token; if (t) pm.collectionVariables.set('token', t);"
